// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

// Seed command: npx prisma db seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  googleId       String       @unique
  email          String       @unique
  name           String
  avatarUrl      String?
  spriteId       String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdFolders Folder[]     @relation("FolderCreator")
  storedFiles    StoredFile[] @relation("FileCreator")

  @@map("users")
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  invitedBy String?
  createdAt DateTime @default(now())

  @@map("allowed_users")
}

model Channel {
  id             String       @id @default(cuid())
  name           String
  type           String       // 'text' or 'voice'
  position       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  folders        Folder[]
  storedFiles    StoredFile[]

  @@map("channels")
}

model ChannelPresence {
  userId    String
  channelId String
  joinedAt  DateTime @default(now())

  @@id([userId, channelId])
  @@map("channel_presences")
}

model Folder {
  id              String       @id @default(uuid()) @db.Uuid
  channelId       String
  parentId        String?      @db.Uuid
  name            String
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  channel         Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent          Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Folder[]     @relation("FolderTree")
  files           StoredFile[]
  createdBy       User         @relation("FolderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([channelId, parentId, name])
  @@index([createdByUserId])
  @@map("folders")
}

model StoredFile {
  id              String   @id @default(uuid()) @db.Uuid
  channelId       String
  folderId        String?  @db.Uuid
  createdByUserId String
  originalName    String
  mimeType        String
  sizeBytes       BigInt
  checksum        String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  folder          Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("FileCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([channelId, folderId, createdAt])
  @@index([channelId, folderId, originalName])
  @@index([createdByUserId])
  @@index([status])
  @@map("files")
}

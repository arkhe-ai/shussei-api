PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://postgres:change-me@postgres:5432/shussei
REDIS_URL=redis://default:change-me@redis:6379

SESSION_SECRET=change-me-session
SESSION_COOKIE_NAME=shussei_session
COOKIE_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Local durable file storage
STORAGE_ROOT_PATH=./storage
MAX_FILE_SIZE_BYTES=52428800
ALLOWED_FILE_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain
